# Not committed: brainstorm/spec docs and other non-code notes (tracked out-of-band)
docs/

# Build outputs / fetched inputs. Heavy build I/O (WORK) defaults to a LOCAL disk
# (~/.cache/mavericks-golang/work), OUTSIDE this NFS repo — see build/versions.sh.
# build/work/ is kept only in case WORK is ever overridden back into the tree.
build/work/
*.pkg
*.tar.gz
*.a
manifest/*.json

# Full package version (<upstream>-mavericks.N). Workflow-written by release.yml (or a
# local test/build/version.sh run) — not committed. See build/version.sh, build/lib.sh.
/VERSION
/dist/

# macOS cruft
.DS_Store

# macOS AppleDouble files
._*
build/updater/
build/updater-cross/
.superpowers/
