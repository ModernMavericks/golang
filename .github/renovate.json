{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ModernMavericks/shared-cmake"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^UPSTREAM_VERSION$/"
      ],
      "matchStrings": [
        "^(?<currentValue>.+?)\\s*$"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    }
  ]
}
